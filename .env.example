# Copia este archivo a .env y completa los valores vacíos. NUNCA subas ni entregues el .env real.
APP_NAME="One Piece Haki Encryption"
APP_ENV=production
APP_KEY=                      # php artisan key:generate
APP_DEBUG=false
APP_URL=https://localhost
FORCE_HTTPS=true

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Base de datos (cuenta SIN privilegios de root) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel_roles
DB_USERNAME=laravel_user
DB_PASSWORD=                  # openssl rand -base64 24 | tr -d '/+=' 
DB_ROOT_PASSWORD=              # Contraseña de root para el contenedor MySQL
DB_MIGRATION_PASSWORD=         # openssl rand -hex 32 (requiere al menos 32 caracteres hexadecimales) 

# --- Contraseñas de usuarios ---
CRYPTO_PEPPER=                # openssl rand -hex 32  (64 caracteres; si la pierdes, nadie podrá entrar)
CRYPTO_ITERATIONS=210000      # solo para cuentas antiguas v1

# --- Sesiones y cookies ---
SESSION_DRIVER=database
SESSION_LIFETIME=30           # minutos de inactividad
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true    # requiere HTTPS: usa https://localhost
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Seguridad ---
LOGIN_MAX_ATTEMPTS=3
LOGIN_WINDOW_SECONDS=180
LOGIN_LOCK_SECONDS=180
RESET_TTL_MINUTES=30
RESET_SHOW_LINK=false         # true únicamente para laboratorio sin correo
SECURITY_ALLOW_REGISTRATION=false
SECURITY_DEMO_SEED=false      # habilitar solo en una base de laboratorio
SECURITY_CHECK_PWNED=true     # consulta contraseñas filtradas (Have I Been Pwned); false si no hay Internet
AUDIT_TIMEZONE=America/Panama

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="soporte@haki.test"
MAIL_FROM_NAME="${APP_NAME}"
